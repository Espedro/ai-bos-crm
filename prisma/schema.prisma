generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ContactStatus {
  LEAD
  QUALIFIED
  CUSTOMER
}

enum ActivityType {
  CONTACT_CREATED
  COMPANY_CREATED
  DEAL_CREATED
  STAGE_CHANGED
  NOTE_ADDED
  TASK_CREATED
  TASK_COMPLETED
  CONVERSATION_STARTED
  CONVERSATION_ESCALATED
}

enum ResourceCategory {
  PRODUCT
  SERVICE
  FAQ
  POLICY
  PRICE_LIST
  OTHER
}

enum ConversationChannel {
  WHATSAPP
  FACEBOOK
  INSTAGRAM
  EMAIL
  WEBCHAT
}

enum ConversationStatus {
  AI_HANDLING
  ESCALATED
  CLOSED
}

enum MessageSender {
  CUSTOMER
  AI
  AGENT
}

enum ChannelConnectionStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
}

enum RecipientSendStatus {
  PENDING
  SENT
  FAILED
}

enum AgentRole {
  ADMIN
  MEMBER
}

/// Tenant root. A "Private" tier deployment has exactly one Business row (its
/// own dedicated Supabase project); a "Standard" tier deployment has many,
/// sharing one Supabase project — same schema and code serve both tiers.
/// `slug` is the tenant-resolution key used in /login/[businessSlug] and
/// /signup, since this app doesn't use subdomains.
model Business {
  id    String @id @default(cuid())
  slug  String @unique
  name  String
  description String?
  /// "From" name/address for mass-mail sends via Resend. Populated once the
  /// business owner verifies their own domain in their own Resend account —
  /// falls back to Resend's shared test sender until then.
  emailFromName    String?
  emailFromAddress String?
  /// Set once the /setup or /signup onboarding flow finishes for this
  /// business — gates access the same way BusinessProfile.completedAt did.
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  agents               Agent[]
  companies            Company[]
  contacts             Contact[]
  stages               Stage[]
  deals                Deal[]
  tasks                Task[]
  notes                Note[]
  activityEvents       ActivityEvent[]
  businessResources    BusinessResource[]
  forms                Form[]
  formSubmissions      FormSubmission[]
  emailTemplates       EmailTemplate[]
  campaigns            Campaign[]
  campaignRecipients   CampaignRecipient[]
  conversations        Conversation[]
  messages             Message[]
  channelConnections   ChannelConnection[]
  commentReplies       CommentReply[]
  tikTokAdsConnections TikTokAdsConnection[]
  tikTokLeads          TikTokLead[]
}

model Agent {
  id         String @id @default(cuid())
  businessId String
  name       String
  email      String
  /// Set on first login (account "claim") — null means this agent hasn't
  /// signed in yet, so the login form treats the submitted password as the
  /// one to set rather than one to verify.
  passwordHash String?
  /// Single-use token emailed for "forgot password" — cleared on use or
  /// once expired (resetTokenExpiresAt).
  resetToken          String?   @unique
  resetTokenExpiresAt DateTime?
  /// ADMIN sees financials and manages Team/Channels/Campaigns/deletions;
  /// MEMBER handles day-to-day contacts/deals/conversations only. Defaults
  /// to ADMIN so existing agents keep full access when this rolls out.
  role      AgentRole @default(ADMIN)
  createdAt DateTime  @default(now())

  business              Business       @relation(fields: [businessId], references: [id])
  assignedContacts      Contact[]
  assignedDeals         Deal[]
  assignedTasks         Task[]
  notes                 Note[]
  assignedConversations Conversation[]

  @@unique([businessId, email])
}

model Company {
  id         String   @id @default(cuid())
  businessId String
  name       String
  industry   String?
  website    String?
  phone      String?
  address    String?
  tags       String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id])
  contacts Contact[]
  deals    Deal[]
  notes    Note[]
}

model Contact {
  id              String        @id @default(cuid())
  businessId      String
  firstName       String
  lastName        String
  email           String?
  phone           String?
  status          ContactStatus @default(LEAD)
  leadScore       Int           @default(0)
  tags            String        @default("")
  companyId       String?
  assignedAgentId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  business           Business            @relation(fields: [businessId], references: [id])
  company            Company?            @relation(fields: [companyId], references: [id])
  assignedAgent      Agent?              @relation(fields: [assignedAgentId], references: [id])
  deals              Deal[]
  tasks              Task[]
  notes              Note[]
  activities         ActivityEvent[]
  conversations      Conversation[]
  formSubmissions    FormSubmission[]
  campaignRecipients CampaignRecipient[]
  tikTokLeads        TikTokLead[]
}

model Stage {
  id         String @id @default(cuid())
  businessId String
  name       String
  order      Int

  business Business @relation(fields: [businessId], references: [id])
  deals    Deal[]
}

model Deal {
  id                String    @id @default(cuid())
  businessId        String
  title             String
  value             Float     @default(0)
  currency          String    @default("USD")
  expectedCloseDate DateTime?
  contactId         String
  companyId         String?
  stageId           String
  assignedAgentId   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  business      Business        @relation(fields: [businessId], references: [id])
  contact       Contact         @relation(fields: [contactId], references: [id])
  company       Company?        @relation(fields: [companyId], references: [id])
  stage         Stage           @relation(fields: [stageId], references: [id])
  assignedAgent Agent?          @relation(fields: [assignedAgentId], references: [id])
  tasks         Task[]
  notes         Note[]
  activities    ActivityEvent[]
}

model Task {
  id              String    @id @default(cuid())
  businessId      String
  title           String
  description     String?
  dueDate         DateTime?
  completed       Boolean   @default(false)
  contactId       String?
  dealId          String?
  assignedAgentId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business      Business @relation(fields: [businessId], references: [id])
  contact       Contact? @relation(fields: [contactId], references: [id])
  deal          Deal?    @relation(fields: [dealId], references: [id])
  assignedAgent Agent?   @relation(fields: [assignedAgentId], references: [id])
}

model Note {
  id            String   @id @default(cuid())
  businessId    String
  body          String
  contactId     String?
  dealId        String?
  companyId     String?
  authorAgentId String?
  createdAt     DateTime @default(now())

  business    Business @relation(fields: [businessId], references: [id])
  contact     Contact? @relation(fields: [contactId], references: [id])
  deal        Deal?    @relation(fields: [dealId], references: [id])
  company     Company? @relation(fields: [companyId], references: [id])
  authorAgent Agent?   @relation(fields: [authorAgentId], references: [id])
}

model ActivityEvent {
  id          String       @id @default(cuid())
  businessId  String
  type        ActivityType
  description String
  contactId   String?
  dealId      String?
  createdAt   DateTime     @default(now())

  business Business @relation(fields: [businessId], references: [id])
  contact  Contact? @relation(fields: [contactId], references: [id])
  deal     Deal?    @relation(fields: [dealId], references: [id])
}

model BusinessResource {
  id         String           @id @default(cuid())
  businessId String
  title      String
  category   ResourceCategory @default(OTHER)
  content    String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  business Business @relation(fields: [businessId], references: [id])
}

/// A public lead-capture form a business shares with a link. Fields are a
/// fixed, curated set (not a drag-drop builder) — kept simple on purpose.
/// `slug` stays globally unique (not composite with businessId) because the
/// public /form/[slug] URL is the only lookup key available there — no
/// session, no other tenant signal.
model Form {
  id             String   @id @default(cuid())
  businessId     String
  name           String
  slug           String   @unique
  description    String?
  /// Header image shown at the top of the public form, stored as a data URI.
  coverImageUrl  String?
  collectPhone   Boolean  @default(true)
  collectMessage Boolean  @default(true)
  /// JSON array of extra fields: [{ "label": string }]
  customFields   String   @default("[]")
  /// Tag applied to the Contact created/updated from a submission, so
  /// campaigns can segment recipients by which form they came through.
  tagOnSubmit    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business    Business         @relation(fields: [businessId], references: [id])
  submissions FormSubmission[]
}

model FormSubmission {
  id         String   @id @default(cuid())
  businessId String
  formId     String
  contactId  String?
  /// JSON snapshot of the raw submitted values, including any custom fields
  /// that don't map onto a Contact column.
  data       String
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])
  form     Form     @relation(fields: [formId], references: [id])
  contact  Contact? @relation(fields: [contactId], references: [id])
}

model EmailTemplate {
  id         String   @id @default(cuid())
  businessId String
  name       String
  subject    String
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business  Business   @relation(fields: [businessId], references: [id])
  campaigns Campaign[]
}

model Campaign {
  id           String         @id @default(cuid())
  businessId   String
  name         String
  subject      String
  body         String
  status       CampaignStatus @default(DRAFT)
  templateId   String?
  /// Simple segmentation: send to Contacts matching this tag and/or status
  /// (both optional; unset means "no filter on that dimension").
  filterTag    String?
  filterStatus ContactStatus?
  scheduledAt  DateTime?
  sentAt       DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  business   Business            @relation(fields: [businessId], references: [id])
  template   EmailTemplate?      @relation(fields: [templateId], references: [id])
  recipients CampaignRecipient[]
}

model CampaignRecipient {
  id         String @id @default(cuid())
  businessId String
  campaignId String
  contactId  String
  /// Opaque token embedded in the tracking pixel/click-redirect URLs so opens
  /// and clicks can be attributed without exposing the recipient's identity.
  /// Stays globally unique — it's the only lookup key at that public boundary.
  trackingToken String              @unique @default(cuid())
  status        RecipientSendStatus @default(PENDING)
  errorMessage  String?
  sentAt        DateTime?
  openedAt      DateTime?
  clickedAt     DateTime?

  business Business @relation(fields: [businessId], references: [id])
  campaign Campaign @relation(fields: [campaignId], references: [id])
  contact  Contact  @relation(fields: [contactId], references: [id])

  @@unique([campaignId, contactId])
}

model Conversation {
  id                  String              @id @default(cuid())
  businessId          String
  contactId           String
  channel             ConversationChannel @default(WHATSAPP)
  status              ConversationStatus  @default(AI_HANDLING)
  assignedAgentId     String?
  channelConnectionId String?
  externalThreadId    String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  business          Business           @relation(fields: [businessId], references: [id])
  contact           Contact            @relation(fields: [contactId], references: [id])
  assignedAgent     Agent?             @relation(fields: [assignedAgentId], references: [id])
  channelConnection ChannelConnection? @relation(fields: [channelConnectionId], references: [id])
  messages          Message[]

  @@index([channelConnectionId, externalThreadId])
}

model ChannelConnection {
  id                 String                  @id @default(cuid())
  businessId         String
  channel            ConversationChannel
  status             ChannelConnectionStatus @default(DISCONNECTED)
  displayName        String?
  phoneNumberId      String?
  wabaId             String?
  pageId             String?
  accessToken        String?
  webhookVerifyToken String
  lastErrorMessage   String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  business       Business       @relation(fields: [businessId], references: [id])
  conversations  Conversation[]
  commentReplies CommentReply[]

  @@unique([businessId, channel])
}

model CommentReply {
  id                  String              @id @default(cuid())
  businessId          String
  channelConnectionId String
  channel             ConversationChannel
  externalCommentId   String              @unique
  postId              String?
  commenterName       String?
  commentText         String
  replyText           String
  createdAt           DateTime            @default(now())

  business          Business          @relation(fields: [businessId], references: [id])
  channelConnection ChannelConnection @relation(fields: [channelConnectionId], references: [id])
}

/// A business's TikTok Ads advertiser authorization, used only to pull Lead
/// Generation ad leads (TikTok has no self-serve DM/messaging API, so this is
/// deliberately ads-only, not a conversation channel). One per business.
model TikTokAdsConnection {
  id               String                  @id @default(cuid())
  businessId       String                  @unique
  status           ChannelConnectionStatus @default(DISCONNECTED)
  displayName      String?
  advertiserId     String?
  accessToken      String?
  lastSyncedAt     DateTime?
  lastErrorMessage String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  business Business     @relation(fields: [businessId], references: [id])
  leads    TikTokLead[]
}

/// Raw record of an ingested TikTok lead, keyed by TikTok's own lead id so
/// re-polling the same lead (task/download can return leads already seen)
/// doesn't create duplicate Contacts or re-trigger AI follow-up.
model TikTokLead {
  id             String   @id @default(cuid())
  businessId     String
  connectionId   String
  externalLeadId String   @unique
  contactId      String?
  /// JSON snapshot of the raw lead payload (name/phone/email/custom
  /// question answers) — field names aren't fully documented by TikTok, so
  /// this is kept verbatim for debugging until the real shape is confirmed.
  data           String
  createdAt      DateTime @default(now())

  business   Business            @relation(fields: [businessId], references: [id])
  connection TikTokAdsConnection @relation(fields: [connectionId], references: [id])
  contact    Contact?            @relation(fields: [contactId], references: [id])
}

model Message {
  id             String        @id @default(cuid())
  businessId     String
  conversationId String
  sender         MessageSender
  body           String
  createdAt      DateTime      @default(now())

  business     Business     @relation(fields: [businessId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])
}
